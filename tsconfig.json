{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2020"],
    "types": [],

    /* The plugin draws over Obsidian's own panes on events nobody asked for out
       loud. A silent undefined here is a canvas left on screen after the pane it
       belonged to is gone, and nobody is watching when it happens. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* esbuild produces the bundle; tsc is here to judge, not to emit. */
    "noEmit": true,

    /* The locales are imported by scripts/ under plain Node, which needs the
       extension written out. */
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "main.js"]
}
