{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["tests/**/*.test.ts", "scripts/*.mjs"],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/*.mjs"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
    "enum": true
  },
  "ignoreBinaries": ["obsidian"],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "unlisted": "error",
    "unresolved": "error"
  }
}
